# ── Docker Compose / production ──
# Copy to .env and fill real values.

# Required for compose
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
HERMES_API_SERVER_KEY=change-this-to-a-strong-random-key-16chars-min
DB_PASSWORD=change-this-production-db-password

# Database: local-first default is SQLite (no DB_ENGINE needed).
# Docker/production must use postgres:
DB_ENGINE=postgres
DB_NAME=ai_skill
DB_USER=postgres
DB_HOST=postgres
DB_PORT=5432

# LLM keys (optional, as needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=
