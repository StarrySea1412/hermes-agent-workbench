# ── Docker Compose 环境变量 ──
# 复制此文件为 .env 并填入实际值

# === 必填 ===
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
HERMES_API_SERVER_KEY=change-this-to-a-strong-random-key-16chars-min
DB_PASSWORD=change-this-production-db-password

# === Hermes LLM 配置 (按需启用) ===
# 选择一个或多个 LLM provider 的 API Key
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === 可选 ===
# Django 调试模式（生产环境必须为 False）
DJANGO_DEBUG=False

# 允许的主机名（逗号分隔，生产环境填实际域名）
DJANGO_ALLOWED_HOSTS=*

# CORS 允许的前端源（逗号分隔，生产环境填实际域名）
# 例: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=

# 数据库
DB_NAME=ai_skill
DB_USER=postgres
DB_HOST=postgres
DB_PORT=5432
