# Local backend env (copy to backend/.env). Never commit real secrets.

# ============ Django 基础 ============
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-not-for-production
JWT_SECRET_KEY=dev-jwt-secret
# 用户模型密钥等敏感配置的加密密钥（Fernet key）。生产环境必须更换
AI_CONFIG_ENCRYPTION_KEY=change-this-to-a-fernet-key-in-production

# ============ 数据库：sqlite（默认）| postgres ============
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# DB_ENGINE=postgres 时启用
# DB_NAME=ai_skill
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ============ AI 提供方（登录后在设置页覆盖） ============
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
AI_DEFAULT_USERNAME=
AI_DEFAULT_TIMEOUT=120
AI_MAX_RETRIES=2

# ============ Hermes 网关 ============
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
# 与 start-ai-skill.ps1 的 API_SERVER_KEY 保持一致（本地开发默认值）
HERMES_GATEWAY_KEY=dev-test-key-for-local
# Hermes 运行时目录（config.yaml / state.db 所在位置），Windows 示例：
HERMES_HOME=D:\path\to\ai-skill\.hermes-runtime

LOCAL_SINGLE_USER_MODE=false

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 可选：联网搜索升级 ============
# 不配置时 web_search 自动使用免 key 的 DuckDuckGo（ddgs）兜底
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=
