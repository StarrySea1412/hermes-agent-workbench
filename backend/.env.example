# Local backend env (copy to backend/.env). Not for production secrets in git.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-not-for-production
JWT_SECRET_KEY=dev-jwt-secret
AI_CONFIG_ENCRYPTION_KEY=change-this-to-a-fernet-key-in-production

# sqlite (default) | postgres
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# Postgres only when DB_ENGINE=postgres
# DB_NAME=ai_skill
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
HERMES_GATEWAY_KEY=

ENABLE_LEGACY_BIDS=false
LOCAL_SINGLE_USER_MODE=false
CELERY_TASK_ALWAYS_EAGER=true
